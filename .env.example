# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=contratos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sistema_contratos
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Host "postgres" = nome do serviço no docker-compose (resolve via rede interna do Compose)
# Role "contratos" = superuser bootstrap do container Postgres (ignora RLS
# incondicionalmente) — usado só para rodar migrations, nunca para servir
# dado de negócio em runtime. Ver APP_DATABASE_URL abaixo.
DATABASE_URL=postgresql://contratos:troque-esta-senha@postgres:5432/sistema_contratos?schema=public

# Role de runtime da API (sem SUPERUSER/BYPASSRLS) — é o que de fato torna a
# Row-Level Security do Postgres uma proteção real, não decorativa (ver
# migration add_row_level_security e README "Role de runtime da API"). Gere
# um valor novo, ex: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_DB_PASSWORD=troque-esta-senha-tambem
APP_DATABASE_URL=postgresql://app_runtime:troque-esta-senha-tambem@postgres:5432/sistema_contratos?schema=public
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Fase 1 — Autenticação (JWT). Gere valores novos em produção, ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=troque-para-um-valor-aleatorio-de-32-bytes
JWT_REFRESH_SECRET=troque-para-outro-valor-aleatorio-de-32-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed inicial (Fase 0) — organização e usuário administrador
SEED_ORG_NOME=Minha Empresa
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_SENHA=troque-esta-senha

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
